---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SERVICES, PORTFOLIO, TEAM, LINKS, url } from '../consts';
---

<Base overlay>
  <section class="hero">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Groupement de Dev et Ops freelance · Aix-Marseille</p>
        <h1>Des infrastructures <span class="hl">innovantes</span> et agiles.</h1>
        <p class="lead">
          Nous sommes un collectif d'Ops indépendants, spécialistes du cloud computing, de la CI/CD et des pratiques
          DevOps. On construit vos plateformes, et on les fait tourner.
        </p>
        <div class="actions">
          <a href={url('/contact/')} class="btn btn-primary">Parlons de votre projet <Icon name="arrow" size={18} /></a>
        </div>
      </div>

      <div class="terminal" role="img" aria-label="Terminal illustrant le cycle build and run">
        <div class="term-head">
          <span></span><span></span><span></span>
          <p class="mono">~/votre-projet</p>
        </div>
        <pre class="mono"><code><span class="p">$</span> bar build --cloud --ci
<span class="ok">✓</span> architecture sur mesure
<span class="ok">✓</span> pipelines CI/CD
<span class="ok">✓</span> conteneurs &amp; orchestration
<span class="p">$</span> bar run --24x7
<span class="ok">✓</span> supervision active
<span class="ok">✓</span> astreinte par des Ops locaux
<span class="dim">→ prod is up. go ship.</span> <span class="caret"></span></code></pre>
      </div>
    </div>
  </section>

  <section class="section" id="expertise">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// expertise</p>
        <h2>Notre cœur de métier</h2>
        <p>Du design de l'architecture à l'exploitation au quotidien, on couvre tout le cycle de vie de vos plateformes.</p>
      </div>
      <div class="services">
        {
          SERVICES.map((s, i) => (
            <article class="card service">
              <div class="icon">
                <Icon name={s.icon} size={26} />
              </div>
              <span class="num mono">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section dark" id="realisations">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// portfolio</p>
        <h2>Quelques réalisations</h2>
        <p>Un aperçu de missions récentes menées par les membres du groupement.</p>
      </div>
      <div class="portfolio">
        {
          PORTFOLIO.map((p) => (
            <article class="project">
              <span class="tag">{p.tag}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="equipe">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">// le groupe</p>
        <h2>Le groupement build-and-run</h2>
        <p>
          Plusieurs professionnels de l'IT, chacun avec ses spécialités. Contactez-nous pour trouver le ou les profils
          adaptés à votre besoin.
        </p>
      </div>
      <div class="team">
        {
          TEAM.map((m) => (
            <article class="card member">
              {m.photo && <Image src={m.photo} alt={m.name} width={160} height={160} class="avatar" />}
              <h3>{m.name}</h3>
              <p>{m.bio}</p>
              <div class="tags">
                {m.tags.map((t) => (
                  <span class="tag">#{t}</span>
                ))}
              </div>
            </article>
          ))
        }
        <a href={url('/contact/')} class="card member join">
          <div class="avatar placeholder"><Icon name="plus" size={40} /></div>
          <h3>Toi, peut-être ?</h3>
          <p>
            Nous recherchons de nouveaux freelances pour faire grandir le groupement. N'hésite pas à nous contacter si
            cela t'intéresse !
          </p>
          <div class="tags">
            <span class="tag">#freelance</span><span class="tag">#ops</span><span class="tag">#aix-marseille</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section cta-wrap">
    <div class="container">
      <div class="cta">
        <div>
          <h2>Un projet, une question, un café&nbsp;?</h2>
          <p>Rejoignez aussi <strong>open-BaR</strong>, notre Slack communautaire pour parler DevOps entre passionnés.</p>
        </div>
        <div class="actions">
          <a href={url('/contact/')} class="btn btn-primary">Nous contacter <Icon name="arrow" size={18} /></a>
          <a href={LINKS.slack} class="btn btn-ghost" target="_blank" rel="noopener"
            ><Icon name="slack" size={18} /> Rejoindre open-BaR</a
          >
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(1200px 600px at 80% -10%, var(--navy-800), transparent 60%), var(--navy-950);
    color: #fff;
    padding: 150px 0 110px;
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at 60% 40%, #000 30%, transparent 75%);
  }
  .glow {
    position: absolute;
    width: 520px;
    height: 520px;
    right: -120px;
    bottom: -260px;
    background: var(--lime);
    filter: blur(140px);
    opacity: 0.18;
    border-radius: 50%;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .hero .eyebrow {
    color: var(--lime);
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 700;
  }
  .hl {
    color: var(--lime);
  }
  .lead {
    font-size: 1.15rem;
    color: rgb(255 255 255 / 0.72);
    max-width: 560px;
    margin: 24px 0 36px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .terminal {
    background: rgb(4 18 33 / 0.85);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius);
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
    overflow: hidden;
  }
  .term-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .term-head span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.18);
  }
  .term-head p {
    margin: 0 0 0 10px;
    font-size: 0.78rem;
    color: rgb(255 255 255 / 0.45);
  }
  .terminal pre {
    margin: 0;
    padding: 22px;
    font-size: 0.9rem;
    line-height: 1.85;
    white-space: pre-wrap;
    color: rgb(255 255 255 / 0.88);
  }
  .p {
    color: var(--lime);
  }
  .ok {
    color: #5ee6a8;
  }
  .dim {
    color: rgb(255 255 255 / 0.5);
  }
  .caret {
    display: inline-block;
    width: 9px;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--lime);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--lime) 60%, var(--border));
    box-shadow: 0 20px 40px -24px rgb(11 42 71 / 0.35);
  }

  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .service {
    position: relative;
  }
  .service .icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--navy-900);
    color: var(--lime);
    margin-bottom: 22px;
  }
  .num {
    position: absolute;
    top: 26px;
    right: 26px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .service h3 {
    font-size: 1.25rem;
    margin-bottom: 10px;
  }
  .service p,
  .member p {
    color: var(--muted);
    margin: 0;
    font-size: 0.97rem;
  }

  .dark {
    background: var(--navy-950);
    color: #fff;
  }
  .dark .eyebrow {
    color: var(--lime);
  }
  .dark .section-head p {
    color: rgb(255 255 255 / 0.65);
  }
  .portfolio {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .project {
    background: var(--navy-950);
    padding: 32px 28px 40px;
    transition: background 0.2s;
  }
  .project:hover {
    background: var(--navy-900);
  }
  .project .tag {
    color: var(--lime);
  }
  .project h3 {
    font-size: 1.3rem;
    margin: 22px 0 8px;
  }
  .project p {
    color: rgb(255 255 255 / 0.6);
    margin: 0;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .member {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 18px;
    outline: 3px solid color-mix(in srgb, var(--lime) 55%, transparent);
    outline-offset: 3px;
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: var(--navy-900);
    color: var(--lime);
  }
  .member h3 {
    font-size: 1.2rem;
    margin-bottom: 8px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 18px;
  }
  .join {
    border-style: dashed;
    border-width: 2px;
  }

  .cta-wrap {
    padding-top: 0;
  }
  .cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    padding: clamp(32px, 5vw, 56px);
    border-radius: 24px;
    color: #fff;
    background: radial-gradient(600px 300px at 100% 100%, rgb(188 227 46 / 0.22), transparent 70%), var(--navy-900);
  }
  .cta h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
  }
  .cta p {
    color: rgb(255 255 255 / 0.7);
    margin: 10px 0 0;
    max-width: 520px;
  }

  @media (max-width: 1000px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .services,
    .portfolio {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 120px 0 72px;
    }
    .services,
    .portfolio {
      grid-template-columns: 1fr;
    }
    .team {
      grid-template-columns: 1fr;
    }
    .terminal pre {
      font-size: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
    .card:hover {
      transform: none;
    }
  }
</style>
