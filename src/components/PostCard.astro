---
import type { CollectionEntry } from 'astro:content';
import { url } from '../consts';
import { formatDate } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
---

<article class="post-card">
  <time class="mono" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
  <h3><a href={url(`/${post.id}/`)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <span class="by">par {post.data.author}</span>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .post-card:hover {
    border-color: color-mix(in srgb, var(--lime) 60%, var(--border));
    transform: translateY(-3px);
  }
  time {
    font-size: 0.8rem;
    color: var(--accent-text);
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a {
    text-decoration: none;
  }
  /* whole card is clickable */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .by {
    margin-top: auto;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
