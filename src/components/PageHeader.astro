---
interface Props {
  eyebrow?: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <slot />
  </div>
</section>

<style>
  .page-header {
    background:
      radial-gradient(800px 400px at 90% 0%, var(--navy-800), transparent 70%),
      var(--navy-950);
    color: #fff;
    padding: 72px 0 64px;
  }
  .eyebrow {
    color: var(--lime);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    max-width: 860px;
  }
  .page-header :global(.meta) {
    margin-top: 18px;
    color: rgb(255 255 255 / 0.65);
  }
</style>
