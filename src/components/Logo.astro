---
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" class="logo-mark">
  <rect x="3" y="6" width="34" height="28" rx="7" fill="none" stroke="currentColor" stroke-width="3.5"></rect>
  <path d="M11 16l4.5 4.5L11 25" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
  <path class="cursor" d="M19.5 25h9" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"></path>
</svg>

<style>
  .logo-mark {
    color: var(--lime);
    flex-shrink: 0;
  }
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
