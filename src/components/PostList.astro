---
import { getCollection, type CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import { url } from '../consts';
import { slugify } from '../utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** slug of the active tag, if any */
  current?: string;
}
const { posts, current } = Astro.props;
const allTags = [...new Set((await getCollection('blog')).flatMap((p) => p.data.tags))].sort((a, b) =>
  slugify(a).localeCompare(slugify(b)),
);
---

<div class="container layout">
  <nav class="tags" aria-label="Étiquettes">
    <a href={url('/blog/')} class="tag" aria-current={!current ? 'page' : undefined}>tous</a>
    {
      allTags.map((t) => (
        <a href={url(`/tag/${slugify(t)}/`)} class="tag" aria-current={current === slugify(t) ? 'page' : undefined}>
          #{t}
        </a>
      ))
    }
  </nav>
  <div class="list">
    {posts.map((p) => <PostCard post={p} />)}
  </div>
</div>

<style>
  .layout {
    padding-block: 40px 96px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }
  .tags .tag[aria-current='page'] {
    background: var(--lime);
    color: var(--navy-950);
  }
  .list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
</style>
