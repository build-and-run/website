---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, LINKS, url } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Header floats over a dark hero instead of having its own background. */
  overlay?: boolean;
}

const { title, description = SITE_DESCRIPTION, overlay = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · Groupement d'ops freelance`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('og-image.png'), Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: url('/'), label: 'Accueil' },
  { href: url('/#expertise'), label: 'Expertise' },
  { href: url('/#equipe'), label: 'Équipe' },
  { href: url('/blog/'), label: 'Blog' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#0b2a47" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@buildAndRunFR" />
  </head>
  <body>
    <a class="sr-only" href="#main">Aller au contenu</a>
    <header class:list={['site-header', { overlay }]}>
      <div class="container bar">
        <a href={url('/')} class="brand" aria-label="Build and Run, accueil">
          <Logo size={34} />
          <span>build<span class="amp">&amp;</span>run</span>
        </a>
        <input type="checkbox" id="nav-toggle" class="sr-only" />
        <label for="nav-toggle" class="burger" aria-label="Menu"><span></span></label>
        <nav aria-label="Navigation principale">
          {
            nav.map((n) => (
              <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <a href={url('/contact/')} class="btn btn-primary nav-cta">Nous contacter</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <a href={url('/')} class="brand">
            <Logo size={30} />
            <span>build<span class="amp">&amp;</span>run</span>
          </a>
          <p class="tagline">Infrastructures innovantes · Groupement de Dev et Ops freelance à Aix-Marseille.</p>
        </div>
        <div class="footer-links">
          <a href={LINKS.linkedin} rel="noopener" target="_blank"><Icon name="linkedin" size={18} /> LinkedIn</a>
          <a href={LINKS.x} rel="noopener" target="_blank"><Icon name="x" size={18} /> X / Twitter</a>
        </div>
      </div>
      <div class="container footer-bottom mono">
        <span>© 2018–{new Date().getFullYear()} Build-and-Run FR</span>
        <span>$ uptime → 99.99%</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--navy-950) 88%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    color: #fff;
  }
  .site-header.overlay {
    position: fixed;
    inset-inline: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .amp {
    color: var(--lime);
    margin-inline: 1px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  nav a:not(.btn) {
    text-decoration: none;
    color: rgb(255 255 255 / 0.75);
    font-weight: 500;
    transition: color 0.15s;
  }
  nav a:not(.btn):hover,
  nav a[aria-current='page'] {
    color: #fff;
  }
  .nav-cta {
    padding: 9px 18px;
    font-size: 0.95rem;
  }
  .burger {
    display: none;
  }

  @media (max-width: 820px) {
    .burger {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      cursor: pointer;
    }
    .burger span,
    .burger span::before,
    .burger span::after {
      display: block;
      width: 22px;
      height: 2px;
      background: #fff;
      border-radius: 2px;
      position: relative;
      transition: transform 0.2s;
    }
    .burger span::before,
    .burger span::after {
      content: '';
      position: absolute;
    }
    .burger span::before {
      top: -7px;
    }
    .burger span::after {
      top: 7px;
    }
    nav {
      position: absolute;
      top: 72px;
      inset-inline: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 16px 20px;
      background: var(--navy-950);
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
      display: none;
    }
    nav a:not(.btn) {
      padding: 14px 4px;
      border-bottom: 1px solid rgb(255 255 255 / 0.06);
    }
    .nav-cta {
      margin-top: 16px;
      justify-content: center;
    }
    #nav-toggle:checked ~ nav {
      display: flex;
    }
    #nav-toggle:checked + .burger span {
      background: transparent;
    }
    #nav-toggle:checked + .burger span::before {
      transform: translateY(7px) rotate(45deg);
    }
    #nav-toggle:checked + .burger span::after {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  .site-footer {
    background: var(--navy-950);
    color: rgb(255 255 255 / 0.8);
    padding-top: 56px;
  }
  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 40px;
  }
  .site-footer .brand {
    color: #fff;
  }
  .tagline {
    max-width: 340px;
    color: rgb(255 255 255 / 0.6);
    margin: 14px 0 0;
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 12px 36px;
    align-content: start;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--lime);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid rgb(255 255 255 / 0.08);
    padding-block: 20px;
    font-size: 0.8rem;
    color: rgb(255 255 255 / 0.45);
  }
</style>
